{
  "name": "scripture-projector",
  "version": "1.4.0",
  "private": true,
  "description": "Offline Bible presentation for churches",
  "author": "Scripture Projector",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build:bible && npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist-electron/preload.cjs",
    "build": "npm run build:bible && tsc --noEmit && vite build && npm run build:electron",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "electron .",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "test:desktop": "npm run build && esbuild tests/layout-entry.ts --bundle --format=iife --global-name=LayoutTest --outfile=dist-electron/layout-test.js && electron tests/electron-smoke.cjs",
    "build:bible": "node --import tsx scripts/build-bible.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-armenian": "^5.2.5",
    "@fontsource/noto-serif-armenian": "^5.2.5",
    "cheerio": "1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "org.scripture.projector",
    "productName": "Scripture Projector",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/main.cjs",
      "dist-electron/preload.cjs",
      "package.json",
      "resources/bibles/*.json",
      "resources/backgrounds/**/*"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
